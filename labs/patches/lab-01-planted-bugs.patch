+#!/bin/bash
+SRC=$1
+DEST=/backups/$(basename $SRC)-$(date +%F).tar.gz
+cd $SRC
+tar czf $DEST *
+rm -rf $SRC/tmp/*
+echo "Backed up $SRC to $DEST"
